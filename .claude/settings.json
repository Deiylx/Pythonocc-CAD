{
  "permissions": {
    "deny": [
      "Edit(/Win64/python3.7/**)",
      "Edit(/Sources/**)",
      "Edit(/Win64/module/Assemble.py)",
      "Read(/.env)"
    ],
    "ask": [
      "Bash(git push *)",
      "PowerShell(git push *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "py",
            "args": ["${CLAUDE_PROJECT_DIR}/tools/hooks/guard_paths.py"],
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "py",
            "args": ["${CLAUDE_PROJECT_DIR}/tools/hooks/ruff_check.py"],
            "timeout": 60
          }
        ]
      }
    ]
  }
}
