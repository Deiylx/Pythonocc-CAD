# Пример без значений. Файл .env в git не попадает.
# tools/ai_call.py и tools/gemini_review.py читают ТОЛЬКО переменные окружения, сам .env не читают.
# Задать на сеанс PowerShell:  $env:GEMINI_API_KEY = "..."
# Ключ для второго мнения от Gemini.
GEMINI_API_KEY=
# Модель (по умолчанию gemini-3.1-pro-preview).
GEMINI_MODEL=
# Модель для --fast (значения по умолчанию нет).
GEMINI_MODEL_FAST=
