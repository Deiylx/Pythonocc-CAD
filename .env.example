# Пример без секретов: ключ пустой. Файл .env в git не попадает.
# tools/ai_call.py и tools/gemini_review.py читают ТОЛЬКО переменные окружения, сам .env не читают.
# Задать на сеанс PowerShell:  $env:GEMINI_API_KEY = "..."
# Ключ для второго мнения от Gemini.
GEMINI_API_KEY=
# Модель (по умолчанию gemini-3.8-flash). Pro-модели без оплаты дают 429 (RESOURCE_EXHAUSTED, лимит 0).
GEMINI_MODEL=gemini-3.8-flash
# Модель для --fast (значения по умолчанию в коде нет).
GEMINI_MODEL_FAST=gemini-3.8-flash
